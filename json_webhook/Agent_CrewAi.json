{
  "name": "Opções Agent CrewAI",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "opcoes-agent"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://seu-endereco-python:8000/agent",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={{ JSON.stringify($json.body) }}"
      },
      "name": "Chama Python CrewAI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {}
    },
    {
      "parameters": {
        "chatIdSource": "body",
        "content": "={{ $json[\"resposta\"] }}"
      },
      "name": "Envia resposta",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [750, 300],
      "credentials": {
        "telegramApi": {
          "id": "<TELEGRAM_CRED_ID>"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Chama Python CrewAI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chama Python CrewAI": {
      "main": [
        [
          {
            "node": "Envia resposta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
