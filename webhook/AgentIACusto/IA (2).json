    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst session = $input.all()\nconst nrotelefonezap = $('Edit Fields3').first().json.payload.from\n//const valorProcurado2 = \"9768134fa4cc47369e1b1b842a2ad92x\";\n\n\n// Usando find para obter o objeto\nconst resultado1 = session\n  .filter(match => match.json.telefone === nrotelefonezap)\n .map((item, index) => `${item.json.nome}`)\n\n//const resultado2 = session.find(item => item.json.sessionId === //valorProcurado2);\n\n// Usando find para obter o objeto\nconst grupo = session\n  .filter(match => match.json.telefone === nrotelefonezap)\n .map((item, index) => `${item.json.grupo_usuario}`)\n\nif (resultado1) {\n  const payloadzap = $('Edit Fields3').first().json\n  return [{ json: { validacao: true, grupo: grupo, sessionid: resultado1, payload: payloadzap  } }];\n} else  {\n\n        const nome = 'Novo';\n        const payloadzap = $('Edit Fields3').first().json\n  return [{ json: { validacao:  true, grupo: null,  sessionid: nome, payload: payloadzap } }];\n}\n"
      },
